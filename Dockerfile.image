FROM mojito-chinese-collector

USER root
RUN apt-get update \
    && apt-get install -y --no-install-recommends python3-pil tesseract-ocr tesseract-ocr-chi-sim \
    && rm -rf /var/lib/apt/lists/*
ENV OMP_THREAD_LIMIT=1
USER 65532:65532
ENTRYPOINT ["/usr/bin/python3", "-B", "/collector/image_capture.py"]
